cache/
out/
node_modules/
.wrangler/
.claude/
# Anchored to repo root only — the root package.json/lock are dev-only (foundry
# helpers). server/package.json MUST stay tracked so Render can build the API.
/package.json
/package-lock.json
.env

# Parallel-agent scratch directories
.codex-audit/
.codex-tmp/
.codex-tmp-audit/
.codex-tmp-local/

# Alternate build outputs
cache-local/
cache-dutch/
out-local/
out-200/
out-dutch/

# Published mirror of zSwap.html. A copy, not a source - regenerate with
# `cp zSwap.html dapp/mirror/index.html` so it can never drift silently.
dapp/mirror/

# Local scratch drivers. `.exec.tmp.mjs` is written against a local anvil and is
# never part of a build; it was untracked and unignored, which is one `git add -A`
# away from being committed.
.exec.tmp.mjs
*.tmp.mjs
